---
import '../styles/global.css';
import Layout from '../layout/Layout.astro';
import EntryCard from '../components/EntryCard.astro';
import DateCard from '../components/DateCard.astro';
import MoodCard from '../components/MoodCard.astro';
import QuoteCard from '../components/QuoteCard.astro';
import StreakCard from '../components/StreakCard.astro';
import ThemesCard from '../components/ThemesCard.astro';
import RecentCard from '../components/RecentCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
---

<Layout title="Mind Diary — Your Thoughts, Beautifully Kept">
  <div class="diary-container">
    <header>
      <h1>Mind Diary</h1>
      <p class="subtitle">YOUR THOUGHTS, BEAUTIFULLY KEPT</p>
    </header>

    <main class="bento">
      <div class="bento-item entry-slot">
        <EntryCard />
      </div>
      <div class="bento-item date-slot">
        <DateCard />
      </div>
      <div class="bento-item mood-slot">
        <MoodCard />
      </div>
      <div class="bento-item quote-slot">
        <QuoteCard />
      </div>
      <div class="bento-item streak-slot">
        <StreakCard />
      </div>
      <div class="bento-item themes-slot">
        <ThemesCard />
      </div>
      <div class="bento-item recent-slot">
        <RecentCard />
      </div>
      <div class="bento-item history-slot">
        <HistoryCard />
      </div>
    </main>

    <footer>
      <p>Mind Diary by Amaury Arteaga G</p>
    </footer>
  </div>
</Layout>

<style>
  .diary-container {
    width: 100%;
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  header {
    text-align: center;
    margin-bottom: 2rem;
  }

  h1 {
    font-family: 'Dancing Script', cursive;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--warm-brown);
    line-height: 1.1;
    text-shadow: 0 2px 4px rgba(107, 66, 38, 0.08);
  }

  .subtitle {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: var(--warm-muted);
    margin-top: 4px;
    font-weight: 600;
  }

  .bento {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .bento-item {
    display: flex;
    flex-direction: column;
  }

  .bento-item > :global(.card) {
    height: 100%;
  }

  /* Bento grid positioning */
  .entry-slot {
    grid-column: span 2;
  }

  .date-slot {
    grid-column: span 1;
  }

  .mood-slot {
    grid-column: span 1;
  }

  .quote-slot {
    grid-column: span 1;
  }

  .streak-slot {
    grid-column: span 1;
  }

  .themes-slot {
    grid-column: span 1;
  }

  .recent-slot {
    grid-column: span 2;
  }

  .history-slot {
    grid-column: span 3;
  }

  footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  footer p {
    font-size: 0.65rem;
    color: var(--warm-muted);
    letter-spacing: 0.05em;
  }

  /* Responsive breakpoints */
  @media (max-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .entry-slot {
      grid-column: span 2;
    }

    .date-slot {
      grid-column: span 1;
    }

    .mood-slot {
      grid-column: span 1;
    }

    .quote-slot {
      grid-column: span 2;
    }

    .streak-slot {
      grid-column: span 1;
    }

    .themes-slot {
      grid-column: span 1;
    }

    .recent-slot {
      grid-column: span 2;
    }

    .history-slot {
      grid-column: span 2;
    }
  }

  @media (max-width: 520px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .entry-slot,
    .date-slot,
    .mood-slot,
    .quote-slot,
    .streak-slot,
    .themes-slot,
    .recent-slot,
    .history-slot {
      grid-column: span 1;
    }

    h1 {
      font-size: 2.75rem;
    }
  }
</style>